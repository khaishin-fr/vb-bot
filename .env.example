DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
# Set to your server ID for instant, server-only command registration.
# Leave blank to register commands globally.
GUILD_ID=

# Docker Compose uses these credentials internally. Change the password before starting.
# Use letters/numbers for this password so it is safe in a MongoDB URI.
MONGO_ROOT_USERNAME=voicebot
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGODB_DATABASE=voice_bot
# Only needed when running Node directly against your own MongoDB instance.
# Compose supplies its own URI using the credentials above.
MONGODB_URI=mongodb://localhost:27017
